# Browser-safe Supabase configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
VITE_SUPABASE_PROJECT_ID=your_project_id
VITE_KAKAO_JS_KEY=your_kakao_javascript_key

# ShowMeLook MCP / Supabase Edge Functions
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_ANON_KEY=your_anon_key

# Server-only secrets — never prefix these with VITE_
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
LOVABLE_API_KEY=optional_hosted_ai_gateway_key
RESEND_API_KEY=optional_email_provider_key
BRIGHTDATA_API_KEY=optional_data_provider_key
BRIGHTDATA_WEBHOOK_SECRET=optional_webhook_secret
COUPANG_ACCESS_KEY=optional_affiliate_access_key
COUPANG_SECRET_KEY=optional_affiliate_secret_key
LINKPRICE_AFFILIATE_ID=optional_affiliate_id
LINKPRICE_WEBHOOK_SECRET=optional_webhook_secret
CAFE24_CLIENT_ID=optional_cafe24_client_id
CAFE24_CLIENT_SECRET=optional_cafe24_client_secret
CAFE24_SKIP_HMAC=false
